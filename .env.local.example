# Copy this file to .env.local for local dev, then set the same vars in Netlify.
# Get Turso credentials from your dashboard: https://turso.tech

VITE_TURSO_URL=https://your-database-name-your-org.turso.io
VITE_TURSO_TOKEN=your-auth-token-here

# AES-256-GCM key used to encrypt student/teacher usernames and display names at rest.
# Must match the value that was used when the database was first seeded —
# changing this will make existing encrypted rows unreadable.
VITE_FIELD_KEY=your-field-encryption-key-here

# Admin account credentials (the admin is not stored in the database).
VITE_ADMIN_PASSWORD=your-admin-password-here

# Auth code required to reset a student password via the reset flow.
VITE_RESET_CODE=your-reset-code-here
